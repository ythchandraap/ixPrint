{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "exec-pwsh",
          "cmd": "powershell.exe",
          "args": [
            "-Command",
            {
              "validator": "^.+$"
            }
          ]
        }
      ]
    },
    "shell:allow-spawn",
    "shell:allow-open",
    "fs:allow-exists",
    "fs:allow-read",
    "fs:allow-resource-read",
    "os:default",
    "fs:default"
  ]
}